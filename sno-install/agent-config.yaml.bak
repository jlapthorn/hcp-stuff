apiVersion: v1alpha1
metadata:
  name: ocp4
rendezvousIP: 95.216.76.100
hosts:
  - hostname: sno.ocp4.lapthorn.me
    role: master
    interfaces:
      - name: enp0s31f6
        macAddress: 90:1b:0e:e4:c2:10
    rootDeviceHints:
      deviceName: /dev/nvme0n1
    networkConfig:
      interfaces:
        - name: enp0s31f6
          type: ethernet
          state: up
          ipv4:
            enabled: true
            address:
              - ip: 95.216.76.100
                prefix-length: 32
            dhcp: false
          ipv6:
            enabled: false
      dns-resolver:
        config:
          server:
            - 185.12.64.1
            - 185.12.64.2
      routes:
        config:
          - destination: 95.216.76.65/32
            next-hop-interface: enp0s31f6
          - destination: 0.0.0.0/0
            next-hop-address: 95.216.76.65
            next-hop-interface: enp0s31f6
